# Nome DNS apontando para o servidor. Para testar localmente, use :80.
SITE_DOMAIN=loja.exemplo.com.br

# Se ficar vazio, uma senha aleatória será mostrada em docker compose logs app.
NEXO_ADMIN_USER=admin
NEXO_ADMIN_PASSWORD=

# Crie um aplicativo no portal do Mercado Livre e cadastre exatamente esta URL de retorno.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://loja.exemplo.com.br/api/mercadolivre/callback

# Pagamentos Pix via PixzyPay. O token existe somente no backend.
PIXZY_BASE_URL=https://app.pixzypay.com/api
PIXZY_API_TOKEN=
PIXZY_WEBHOOK_URL=https://loja.exemplo.com.br/api/webhooks/pixzypay/transactions

# TTL em segundos para rascunhos importados e validade do preço público.
ML_CACHE_TTL=900
# Segredo de assinatura de sessões. Configure um valor aleatório no ambiente definitivo.
NEXO_SESSION_SECRET=
# Paginação de avaliações: 1 a 10 páginas de até 10 comentários.
ML_REVIEW_MAX_PAGES=1
# Chave Fernet do servidor para criptografia de credenciais. Guarde fora do banco.
# Gere com: .local/venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Sem esta variável, uma chave local privada é criada no volume (oauth.key).
NEXO_CREDENTIAL_KEY=
